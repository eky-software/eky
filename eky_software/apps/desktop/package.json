{
  "name": "@eky/desktop",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "backup:scrypt-benchmark": "node scripts/benchmark-backup-scrypt.mjs",
    "e2e:build": "node scripts/clean-e2e-dist.mjs && tsc -p tsconfig.e2e.json && node scripts/write-electron-e2e-package.mjs",
    "e2e:prepare-backend": "node scripts/prepare-electron-e2e-backend.mjs",
    "e2e:prepare-electron-runtime": "pnpm exec install-electron --no && node scripts/assert-electron-development-runtime.mjs",
    "installer:test": "pnpm installer:test:unit && pnpm installer:test:windows-process",
    "installer:test:unit": "node --test installer/installerIdentity.test.mjs installer/installerManifest.test.mjs installer/installerReleaseContext.test.mjs installer/installerToolchainPolicy.test.mjs installer/installerVersion.test.mjs installer/scripts/buildW6bSyntheticNextPatchInstaller.test.mjs installer/scripts/buildW6b2PackagedSuccessInstallers.test.mjs installer/scripts/buildWindowsInstaller.test.mjs installer/scripts/createLocalPilotReleaseBundle.test.mjs installer/scripts/generateInstallerPayload.test.mjs installer/scripts/historicalWindowsApplicationBuilder.test.mjs installer/scripts/historicalWindowsInstallerBuilder.test.mjs installer/scripts/historicalWindowsInstallerFixtureBuilder.test.mjs installer/scripts/historicalWindowsInstallerFixturePolicy.test.mjs installer/scripts/historicalWindowsInstallerFixtureProvenance.test.mjs installer/scripts/historicalWindowsInstallerToolchain.test.mjs installer/scripts/historicalWindowsInstallerVerifier.test.mjs installer/scripts/materializeHistoricalWindowsInstallerSource.test.mjs installer/scripts/prepareWindowsInstallerUpgradeFixture.test.mjs installer/scripts/releaseWindowsInstaller.test.mjs installer/scripts/runW6b2PackagedSuccess.test.mjs installer/scripts/runWindowsInstallerReleaseLifecycle.test.mjs installer/scripts/testW6b2PackagedSuccess.test.mjs installer/scripts/w6bSyntheticWindowsPackageFixture.test.mjs installer/scripts/w6b2HistoricalBackendStage.test.mjs installer/scripts/w6b2PackagedSuccessRunFixture.test.mjs installer/scripts/w6b2PrivateProofPackageMarker.test.mjs installer/scripts/w6b2SyntheticWindowsPackageFixture.test.mjs",
    "installer:test:windows-process": "node --test --test-concurrency=1 installer/scripts/runW6bLegacyUpgradeAcceptance.test.mjs installer/scripts/w6b2SuccessApplicationProcess.test.mjs installer/scripts/windowsInstallerProcessTree.test.mjs installer/scripts/windowsInstallerTestSupport.test.mjs installer/scripts/windowsInstallerUpgradeAttempt.test.mjs",
    "installer:build-w6b-target": "node installer/scripts/buildW6bSyntheticNextPatchInstaller.mjs",
    "installer:build-w6b2-pair": "node installer/scripts/buildW6b2PackagedSuccessInstallers.mjs",
    "installer:build": "node installer/scripts/buildWindowsInstaller.mjs",
    "installer:build-upgrade-fixture": "node installer/scripts/prepareWindowsInstallerUpgradeFixture.mjs",
    "installer:inspect": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/inspectWindowsInstaller.ps1",
    "installer:local-pilot-bundle": "node installer/scripts/createLocalPilotReleaseBundle.mjs",
    "installer:lifecycle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/testWindowsInstallerLifecycle.ps1",
    "installer:release": "node installer/scripts/releaseWindowsInstaller.mjs",
    "installer:release-lifecycle": "node installer/scripts/runWindowsInstallerReleaseLifecycle.mjs",
    "installer:verify-restore-lock": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/verifyLockedInstallerRestore.ps1",
    "installer:verify-release": "node installer/scripts/verifyWindowsInstallerRelease.mjs",
    "installer:verify-historical-fixture": "node installer/scripts/verifyHistoricalWindowsInstallerFixture.mjs",
    "installer:w6b-legacy": "node installer/scripts/runW6bLegacyUpgradeAcceptance.mjs",
    "installer:w6b2-success": "pnpm e2e:build && node installer/scripts/runW6b2PackagedSuccess.mjs",
    "installer:upgrade": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/testWindowsInstallerUpgrade.ps1",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows:pilot": "node scripts/package-windows.mjs --pilot",
    "profile:audit": "node scripts/audit-production-profile.mjs",
    "smoke:windows": "node scripts/run-packaged-smoke.mjs",
    "smoke:windows:release-candidate": "node scripts/run-packaged-smoke.mjs --release-candidate",
    "test": "vitest run src e2e/w6b2PackagedWorkspaceFixtures.test.ts e2e/w6b2PackagedWorkspaceMigrationHistory.test.ts e2e/w6b2PackagedWorkspaceProfileCommand.test.ts e2e/w6b2PackagedWorkspaceProfileState.test.ts && node --test scripts/electron-development-runtime.test.mjs scripts/inspect-support-bundle.test.mjs scripts/package-artifact-inventory.test.mjs scripts/packaged-release-candidate.test.mjs scripts/pilot-build-gate.test.mjs scripts/preparePackageBackendStage.test.mjs scripts/production-profile-audit.test.mjs scripts/read-desktop-electron-version.test.mjs scripts/staged-better-sqlite-runtime.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "@types/node": "^24.13.3",
    "electron": "43.3.0"
  }
}
