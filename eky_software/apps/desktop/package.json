-supervisor/tests/windowsAcceptanceSupervisor.contract.test.mjs installer/windows-acceptance-harness/cleanCallerResult.test.mjs installer/windows-acceptance-harness/cleanCommandPhase.test.mjs installer/windows-acceptance-harness/cleanInstallUninstallFailureBoundary.test.mjs installer/windows-acceptance-harness/upgradeCallerResult.test.mjs installer/windows-acceptance-harness/upgradeCommandPhase.test.mjs installer/windows-acceptance-harness/upgradeRollbackFailureBoundary.test.mjs installer/windows-acceptance-harness/upgradeRollbackContracts.test.mjs installer/windows-acceptance-harness/upgradeRollbackLifecycle.test.mjs installer/windows-acceptance-harness/upgradeRunningApplication.test.mjs installer/windows-acceptance-harness/runningUpgradeObservation.test.mjs installer/windows-acceptance-harness/nativeMsiUpgradeProcess.test.mjs",
