{
  "name": "@eky/desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "backup:scrypt-benchmark": "node scripts/benchmark-backup-scrypt.mjs",
    "e2e:build": "node scripts/clean-e2e-dist.mjs && tsc -p tsconfig.e2e.json && node scripts/write-electron-e2e-package.mjs",
    "e2e:prepare-backend": "node scripts/prepare-electron-e2e-backend.mjs",
    "e2e:prepare-electron-runtime": "pnpm exec install-electron --no && node scripts/assert-electron-development-runtime.mjs",
    "installer:test": "node --test installer/installerIdentity.test.mjs installer/installerManifest.test.mjs installer/installerReleaseContext.test.mjs installer/installerToolchainPolicy.test.mjs installer/installerVersion.test.mjs installer/scripts/buildWindowsInstaller.test.mjs installer/scripts/createLocalPilotReleaseBundle.test.mjs installer/scripts/generateInstallerPayload.test.mjs installer/scripts/prepareWindowsInstallerUpgradeFixture.test.mjs installer/scripts/releaseWindowsInstaller.test.mjs installer/scripts/runWindowsInstallerReleaseLifecycle.test.mjs",
    "installer:build": "node installer/scripts/buildWindowsInstaller.mjs",
    "installer:build-upgrade-fixture": "node installer/scripts/prepareWindowsInstallerUpgradeFixture.mjs",
    "installer:inspect": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/inspectWindowsInstaller.ps1",
    "installer:local-pilot-bundle": "node installer/scripts/createLocalPilotReleaseBundle.mjs",
    "installer:lifecycle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/testWindowsInstallerLifecycle.ps1",
    "installer:release": "node installer/scripts/releaseWindowsInstaller.mjs",
    "installer:release-lifecycle": "node installer/scripts/runWindowsInstallerReleaseLifecycle.mjs",
    "installer:verify-restore-lock": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/verifyLockedInstallerRestore.ps1",
    "installer:verify-release": "node installer/scripts/verifyWindowsInstallerRelease.mjs",
    "installer:upgrade": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/scripts/testWindowsInstallerUpgrade.ps1",
    "package:windows": "node scripts/package-windows.mjs",
    "package:windows:pilot": "node scripts/package-windows.mjs --pilot",
    "profile:audit": "node scripts/audit-production-profile.mjs",
    "smoke:windows": "node scripts/run-packaged-smoke.mjs",
    "smoke:windows:release-candidate": "node scripts/run-packaged-smoke.mjs --release-candidate",
    "test": "vitest run src && node --test scripts/electron-development-runtime.test.mjs scripts/inspect-support-bundle.test.mjs scripts/package-artifact-inventory.test.mjs scripts/packaged-release-candidate.test.mjs scripts/pilot-build-gate.test.mjs scripts/production-profile-audit.test.mjs scripts/read-desktop-electron-version.test.mjs scripts/staged-better-sqlite-runtime.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "@types/node": "^24.13.3",
    "electron": "43.2.0"
  }
}
