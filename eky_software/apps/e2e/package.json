{
  "name": "@eky/e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:prepare": "pnpm --filter @eky/permissions build && pnpm --filter @eky/auth build && pnpm --filter @eky/backend e2e:build",
    "e2e:electron:prepare": "pnpm --filter @eky/desktop e2e:prepare-electron-runtime && pnpm --filter @eky/permissions build && pnpm --filter @eky/auth build && pnpm --filter @eky/backend e2e:build && pnpm --filter @eky/web build && pnpm --filter @eky/desktop build && pnpm --filter @eky/desktop e2e:build && pnpm --filter @eky/desktop e2e:prepare-backend",
    "e2e:system": "pnpm e2e:prepare && playwright test --project=system-api",
    "e2e:web": "pnpm e2e:prepare && playwright test --project=web-chromium",
    "e2e:web:critical": "pnpm e2e:prepare && playwright test --project=web-chromium --grep @critical",
    "e2e:security": "pnpm e2e:prepare && playwright test --grep @security",
    "e2e:fault": "pnpm e2e:prepare && playwright test --grep @fault",
    "e2e:electron": "pnpm e2e:electron:prepare && playwright test --project=electron-development",
    "e2e:electron:critical": "pnpm e2e:electron:prepare && playwright test --project=electron-development --grep @critical --workers=1",
    "e2e:desktop-stress": "pnpm e2e:electron:prepare && playwright test --project=electron-endurance --grep @desktop-stress --workers=1",
    "e2e:desktop-soak": "pnpm e2e:electron:prepare && playwright test --project=electron-endurance --grep @soak --workers=1",
    "e2e:critical": "pnpm e2e:prepare && playwright test --project=system-api --project=web-chromium --grep @critical",
    "e2e:stress": "pnpm e2e:prepare && playwright test --project=endurance-baseline",
    "e2e:all": "pnpm e2e:electron:prepare && playwright test --project=system-api --project=web-chromium --project=electron-development",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
